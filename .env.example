WHATSAPP_MCP_LISTEN_ADDR=":8080"
WHATSAPP_MCP_MCP_PATH="/mcp"
WHATSAPP_MCP_MEDIA_PATH_PREFIX="/media"
WHATSAPP_MCP_MEDIA_TTL_SECONDS="600"

# Set this when tunneling so media URLs are reachable.
WHATSAPP_MCP_BASE_URL="https://<your-tunnel-hostname>"

# Recommended behind Cloudflare Tunnel.
WHATSAPP_MCP_DISABLE_TLS="true"

# Only used when WHATSAPP_MCP_DISABLE_TLS is not true.
WHATSAPP_MCP_TLS_CERT="store/server.crt"
WHATSAPP_MCP_TLS_KEY="store/server.key"
